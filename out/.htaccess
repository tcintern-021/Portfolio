<IfModule mod_headers.c>
  # HTML Documents - Prevent caching to avoid stale chunk references after a deployment
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Next.js Static Assets and Images - Aggressive caching for hashed immutable assets
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
